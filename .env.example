# ClaimFlow AI Environment Configuration

# Application
APP_NAME=ClaimFlow AI
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database
# Local SQLite default (zero Docker required):
DATABASE_URL=sqlite+aiosqlite:///./claimflow.db
SYNC_DATABASE_URL=sqlite:///./claimflow.db
# PostgreSQL + pgvector option:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/claimflow
# SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/claimflow

# LLM Providers (Zero-Cost / Configurable)
# Set MOCK_LLM=true to run completely offline without any API keys (ideal for CI and testing)
MOCK_LLM=true

# Primary: Google Gemini API (Free tier available)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Fallback 1: Groq API (Free tier available)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback 2: Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# LangGraph Checkpointer
CHECKPOINT_DB_PATH=./checkpoints.db

# Guidelines & Thresholds for Adjudication
STP_MAX_NET_PAYOUT=2000.00
STP_MAX_FRAUD_SCORE=30.00
POLICY_BIND_SUSPICIOUS_DAYS=15

# Guidewire Simulated Webhook Endpoint
GUIDEWIRE_WEBHOOK_URL=https://claimcenter.mock.internal/api/claims/v1
